
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isMember() {
      return request.auth != null &&
        request.auth.uid in [
          "nnmJ6qBxkjM6FWaoLNW7xSf6ueP2",
          "9zz0Nf7kqgUlZygavq15IKdhz903"
        ];
    }

    function isAdmin() {
      return request.auth != null &&
        request.auth.uid == "nnmJ6qBxkjM6FWaoLNW7xSf6ueP2";
    }

    match /{document=**} {
      allow read: if isMember();
      allow write: if isAdmin();
    }
  }
}
